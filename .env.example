# Copy this file to .env (it is gitignored) and fill in what you use.
# The gateway loads it on `dollygrip serve`, `dollygrip mcp` and `dollygrip run`.
# Shell environment variables always win over this file.

# Stock footage providers - free keys: https://www.pexels.com/api/  https://pixabay.com/api/docs/
# Coverr keys are issued on request at https://coverr.co/
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
# Several keys rotate when comma-separated:
# DOLLYGRIP_PEXELS_KEYS=key1,key2

# Script -> stock-search keywords (POST /stock/keywords, /stock/b-roll with `script`).
# Unset = offline heuristic. anthropic | openai | deepseek uses the matching key below;
# any provider failure falls back to the heuristic.
# DOLLYGRIP_KEYWORDS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# Model override (defaults: claude-sonnet-5 / gpt-4o-mini / deepseek-chat)
# DOLLYGRIP_KEYWORDS_MODEL=

# Where stock downloads land on the Resolve machine (default: ~/DollyGrip/stock)
# DOLLYGRIP_MEDIA_DIR=D:/stock

# Only if Resolve is installed somewhere unusual (defaults are the standard install paths)
# RESOLVE_SCRIPT_API=C:/ProgramData/Blackmagic Design/DaVinci Resolve/Support/Developer/Scripting
# RESOLVE_SCRIPT_LIB=C:/Program Files/Blackmagic Design/DaVinci Resolve/fusionscript.dll
